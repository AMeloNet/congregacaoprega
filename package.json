{
  "name": "congregacaoprega",
  "version": "0.0.0",
  "private": true,
  "description": "Sistema de organização do Testemunho Público",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "capture": "node scripts/capture-client.mjs",
    "db:generate": "pnpm --filter @congregacaoprega/database db:generate",
    "db:validate": "pnpm --filter @congregacaoprega/database db:validate",
    "docs:check": "node scripts/check-docs.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --project database-integration --maxWorkers=1 --no-file-parallelism",
    "test:unit": "vitest run --project api-unit --project web-unit --maxWorkers=1 --no-file-parallelism",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@swc/core": "1.16.2",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "unplugin-swc": "1.6.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
