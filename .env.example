# Exemplo local com valores fictícios. Nunca versione credenciais reais.
DATABASE_URL=postgresql://app_user:change_me@127.0.0.1:5432/congregacaoprega
AUTH0_ISSUER=https://seu-tenant.auth0.com/
AUTH0_CLIENT_ID=replace_with_auth0_client_id
AUTH0_CLIENT_SECRET=replace_with_auth0_client_secret
AUTH0_AUDIENCE=https://api.congregacaoprega.example
AUTH0_CALLBACK_URL=http://127.0.0.1:3000/api/auth/callback
AUTH0_LOGOUT_URL=http://127.0.0.1:5173/
SESSION_SECRET=replace_with_at_least_32_random_characters
BOOTSTRAP_SECRET=replace_with_a_distinct_operational_secret
CAPTURE_OPERATOR_SECRET=replace_with_another_distinct_32_character_secret
APP_BASE_URL=http://127.0.0.1:5173
EMAIL_TRANSPORT=capture
