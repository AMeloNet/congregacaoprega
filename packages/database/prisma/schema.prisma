generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  PUBLISHER
  LOCAL_ADMIN

  @@map("membership_role")
}

enum MembershipStatus {
  ACTIVE
  REVOKED

  @@map("membership_status")
}

enum InvitationKind {
  MEMBERSHIP
  MASTER_BOOTSTRAP

  @@map("invitation_kind")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
  SUPERSEDED

  @@map("invitation_status")
}

enum IdentityAuditEventType {
  MEMBERSHIP_INVITED
  MEMBERSHIP_REVOKED
  MEMBERSHIP_REACTIVATED
  LOCAL_ADMIN_GRANTED
  LOCAL_ADMIN_REVOKED
  MASTER_BOOTSTRAP_ISSUED

  @@map("identity_audit_event_type")
}

enum IdentityAuditOutcome {
  SUCCEEDED
  DENIED
  FAILED

  @@map("identity_audit_outcome")
}

model IdentityAccount {
  id              String       @id @default(uuid()) @db.Uuid
  providerIssuer  String       @map("provider_issuer")
  providerSubject String       @map("provider_subject")
  email           String
  emailVerified   Boolean      @default(false) @map("email_verified")
  isMaster        Boolean      @default(false) @map("is_master")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  weeklyHoursHistory WeeklyHoursHistory[]
  pointWeeklyHoursHistory PointWeeklyHoursHistory[]
  equipmentHistory EquipmentStateHistory[]
  memberships     Membership[]
  createdInvitations AccessInvitation[] @relation("InvitationCreator")
  actedAuditEvents   IdentityAuditEvent[] @relation("AuditActor")
  subjectAuditEvents IdentityAuditEvent[] @relation("AuditSubject")
  scheduleMonthHistory ScheduleMonthHistory[]
  reservations Reservation[]

  @@unique([providerIssuer, providerSubject])
  @@map("identity_account")
}

model Congregation {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  timezone    String       @default("America/Sao_Paulo")
  weeklyHoursVersion Int @default(0) @map("weekly_hours_version")
  weeklyHoursDays WeeklyHoursDay[]
  weeklyHoursHistory WeeklyHoursHistory[]
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  memberships Membership[]
  equipment Equipment[]
  points PreachingPoint[]
  invitations AccessInvitation[]
  auditEvents IdentityAuditEvent[]
  scheduleMonths ScheduleMonth[]
  reservations Reservation[]

  @@map("congregation")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  accountId      String           @map("account_id") @db.Uuid
  congregationId String           @map("congregation_id") @db.Uuid
  role           MembershipRole   @default(PUBLISHER)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz(6)
  account        IdentityAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  congregation   Congregation     @relation(fields: [congregationId], references: [id], onDelete: Restrict)
  auditEvents    IdentityAuditEvent[]

  @@unique([accountId, congregationId])
  @@index([congregationId, status])
  @@map("membership")
}

model AccessInvitation {
  id                       String           @id @default(uuid()) @db.Uuid
  kind                     InvitationKind
  congregationId           String?          @map("congregation_id") @db.Uuid
  recipientEmail           String           @map("recipient_email")
  recipientEmailNormalized String           @map("recipient_email_normalized")
  tokenDigest              Bytes            @unique @map("token_digest")
  targetRole               MembershipRole?  @map("target_role")
  status                   InvitationStatus @default(PENDING)
  expiresAt                DateTime         @map("expires_at") @db.Timestamptz(6)
  completedAt              DateTime?        @map("completed_at") @db.Timestamptz(6)
  invalidatedAt            DateTime?        @map("invalidated_at") @db.Timestamptz(6)
  createdByAccountId       String?          @map("created_by_account_id") @db.Uuid
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  congregation             Congregation?    @relation(fields: [congregationId], references: [id], onDelete: Restrict)
  createdByAccount         IdentityAccount? @relation("InvitationCreator", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  auditEvents              IdentityAuditEvent[]

  @@index([congregationId, recipientEmailNormalized], map: "access_invitation_congregation_id_recipient_email_normalized_id")
  @@map("access_invitation")
}

model IdentityAuditEvent {
  id               String                 @id @default(uuid()) @db.Uuid
  eventType        IdentityAuditEventType @map("event_type")
  outcome          IdentityAuditOutcome
  actorAccountId   String?                @map("actor_account_id") @db.Uuid
  subjectAccountId String?                @map("subject_account_id") @db.Uuid
  congregationId   String?                @map("congregation_id") @db.Uuid
  invitationId     String?                @map("invitation_id") @db.Uuid
  membershipId     String?                @map("membership_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  actorAccount     IdentityAccount?       @relation("AuditActor", fields: [actorAccountId], references: [id], onDelete: Restrict)
  subjectAccount   IdentityAccount?       @relation("AuditSubject", fields: [subjectAccountId], references: [id], onDelete: Restrict)
  congregation     Congregation?          @relation(fields: [congregationId], references: [id], onDelete: Restrict)
  invitation       AccessInvitation?      @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  membership       Membership?            @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@index([congregationId, createdAt])
  @@map("identity_audit_event")
}

enum EquipmentType {
  CART
  KIOSK
  DISPLAY

  @@map("equipment_type")
}

model Equipment {
  id String @id @default(uuid()) @db.Uuid
  congregationId String @map("congregation_id") @db.Uuid
  name String
  type EquipmentType
  active Boolean @default(true)
  observation String @default("")
  congregation Congregation @relation(fields: [congregationId], references: [id], onDelete: Restrict)
  history EquipmentStateHistory[]

  @@map("equipment")
}

model EquipmentStateHistory {
  id String @id @default(uuid()) @db.Uuid
  equipmentId String @map("equipment_id") @db.Uuid
  actorAccountId String @map("actor_account_id") @db.Uuid
  active Boolean
  observation String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  actorAccount IdentityAccount @relation(fields: [actorAccountId], references: [id], onDelete: Restrict)

  @@index([equipmentId, createdAt], map: "equipment_state_history_equipment_created_idx")
  @@map("equipment_state_history")
}

model PreachingPoint {
  id String @id @default(uuid()) @db.Uuid
  congregationId String @map("congregation_id") @db.Uuid
  name String
  address String @default("")
  description String @default("")
  capacity Int @default(1)
  allowedTypes EquipmentType[] @map("allowed_types")
  weeklyHoursVersion Int @default(0) @map("weekly_hours_version")
  weeklyHoursDays PointWeeklyHoursDay[]
  weeklyHoursHistory PointWeeklyHoursHistory[]
  reservations Reservation[]
  congregation Congregation @relation(fields: [congregationId], references: [id], onDelete: Restrict)

  @@map("preaching_point")
}

model WeeklyHoursDay {
  congregationId String       @map("congregation_id") @db.Uuid
  day            Int
  mode           String
  intervals      Json
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Restrict)

  @@id([congregationId, day])
  @@map("weekly_hours_day")
}

model PointWeeklyHoursDay {
  pointId String @map("point_id") @db.Uuid
  day Int
  mode String
  intervals Json
  point PreachingPoint @relation(fields: [pointId], references: [id], onDelete: Restrict)

  @@id([pointId, day])
  @@map("point_weekly_hours_day")
}

model PointWeeklyHoursHistory {
  id String @id @default(uuid()) @db.Uuid
  pointId String @map("point_id") @db.Uuid
  actorAccountId String @map("actor_account_id") @db.Uuid
  previous Json
  configuration Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  point PreachingPoint @relation(fields: [pointId], references: [id], onDelete: Restrict)
  actorAccount IdentityAccount @relation(fields: [actorAccountId], references: [id], onDelete: Restrict)

  @@index([pointId, createdAt], map: "point_weekly_hours_history_point_created_idx")
  @@map("point_weekly_hours_history")
}

model WeeklyHoursHistory {
  id             String          @id @default(uuid()) @db.Uuid
  congregationId String          @map("congregation_id") @db.Uuid
  actorAccountId String          @map("actor_account_id") @db.Uuid
  previous       Json
  configuration  Json
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  congregation   Congregation    @relation(fields: [congregationId], references: [id], onDelete: Restrict)
  actorAccount   IdentityAccount @relation(fields: [actorAccountId], references: [id], onDelete: Restrict)

  @@index([congregationId, createdAt], map: "weekly_hours_history_congregation_created_idx")
  @@map("weekly_hours_history")
}

model ScheduleMonth {
  congregationId String @map("congregation_id") @db.Uuid
  month String
  state String @default("open")
  congregation Congregation @relation(fields: [congregationId], references: [id], onDelete: Restrict)
  history ScheduleMonthHistory[]
  @@id([congregationId, month])
  @@map("schedule_month")
}

model ScheduleMonthHistory {
  id String @id @default(uuid()) @db.Uuid
  congregationId String @map("congregation_id") @db.Uuid
  month String
  actorAccountId String @map("actor_account_id") @db.Uuid
  previousState String @map("previous_state")
  state String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  scheduleMonth ScheduleMonth @relation(fields: [congregationId, month], references: [congregationId, month], onDelete: Restrict, map: "schedule_month_history_month_fkey")
  actorAccount IdentityAccount @relation(fields: [actorAccountId], references: [id], onDelete: Restrict)
  @@map("schedule_month_history")
}

model Reservation {
  id String @id @default(uuid()) @db.Uuid
  congregationId String @map("congregation_id") @db.Uuid
  pointId String @map("point_id") @db.Uuid
  responsibleAccountId String @map("responsible_account_id") @db.Uuid
  requestKey String @map("request_key") @db.Uuid
  localDate String @map("local_date")
  startHour Int @map("start_hour")
  duration Int
  equipmentType EquipmentType @map("equipment_type")
  thirdPositionOpen Boolean @map("third_position_open")
  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt DateTime @map("ends_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  congregation Congregation @relation(fields: [congregationId], references: [id], onDelete: Restrict)
  point PreachingPoint @relation(fields: [pointId], references: [id], onDelete: Restrict)
  responsible IdentityAccount @relation(fields: [responsibleAccountId], references: [id], onDelete: Restrict)
  @@unique([congregationId, responsibleAccountId, requestKey], map: "reservation_request_key")
  @@index([congregationId, startsAt, endsAt], map: "reservation_congregation_interval_idx")
  @@index([responsibleAccountId, startsAt, endsAt], map: "reservation_responsible_interval_idx")
  @@map("reservation")
}
